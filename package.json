{
  "name": "binance-mcp-server",
  "version": "0.1.0",
  "description": "Read-only Binance Spot market data MCP server for AI analysis.",
  "type": "module",
  "bin": {
    "binance-mcp-server": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js"
  },
  "keywords": [
    "mcp",
    "binance",
    "market-data",
    "trading",
    "ai"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "dotenv": "16.6.1",
    "https-proxy-agent": "7.0.6",
    "node-fetch": "3.3.2",
    "socks-proxy-agent": "8.0.5",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
